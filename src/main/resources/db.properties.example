# Copy this file to db.properties and fill in your local values.
# db.properties is git-ignored on purpose - never commit real credentials.
#
# Every value can also be supplied through an environment variable,
# which always takes priority over this file:
#   POS_DB_URL, POS_DB_USER, POS_DB_PASSWORD

db.url=jdbc:sqlserver://localhost:1433;databaseName=pos_db;encrypt=false;trustServerCertificate=true
db.user=pos_app
db.password=PosApp@12345
