<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<!--
  SHARED FILE - the standard application frame.
  Feature developers must not edit this file; they render their own FXML
  inside contentArea through MainLayoutController.loadView(...).
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.layout.MainLayoutController"
            styleClass="app-root"
            prefWidth="1280.0" prefHeight="720.0"
            minWidth="1024.0" minHeight="650.0">

    <top>
        <fx:include fx:id="topBar" source="top-bar.fxml"/>
    </top>

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

    <bottom>
        <fx:include fx:id="statusBar" source="status-bar.fxml"/>
    </bottom>

</BorderPane>
