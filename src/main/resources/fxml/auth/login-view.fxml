<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import ui.components.AppButton?>
<?import ui.components.AppPasswordField?>
<?import ui.components.AppTextField?>

<!--
  Pre-authentication screen (Engineer 1).
  No top bar / sidebar / status bar on purpose: uiContract section 2 scopes the
  standard frame to post-authentication screens. Colours, typography, spacing,
  inputs and buttons all come from the shared system.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pos.auth.controller.LoginController"
      styleClass="login-root"
      alignment="CENTER"
      spacing="24.0">

    <children>
        <VBox styleClass="login-card">
            <children>

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="login-logo" text="نظام نقاط البيع"/>
                        <Label styleClass="text-secondary" text="سجّل الدخول للمتابعة"/>
                    </children>
                </VBox>

                <VBox styleClass="form-field">
                    <children>
                        <Label styleClass="field-label" text="اسم المستخدم"/>
                        <AppTextField fx:id="usernameField" promptText="أدخل اسم المستخدم"/>
                    </children>
                </VBox>

                <VBox styleClass="form-field">
                    <children>
                        <Label styleClass="field-label" text="كلمة المرور"/>
                        <AppPasswordField fx:id="passwordField" promptText="أدخل كلمة المرور"/>
                    </children>
                </VBox>

                <Label fx:id="errorLabel"
                       styleClass="error-label"
                       managed="false"
                       visible="false"
                       text=""/>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <AppButton fx:id="loginButton"
                                   variant="PRIMARY"
                                   text="تسجيل الدخول"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onLogin"/>
                        <ProgressIndicator fx:id="loginProgressIndicator"
                                           managed="false"
                                           visible="false"
                                           prefWidth="24.0" prefHeight="24.0"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
