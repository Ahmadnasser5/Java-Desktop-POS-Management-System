<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import ui.components.AppButton?>
<?import ui.components.AppPasswordField?>

<!-- Change my own password. Also used forced, at first sign in (Engineer 1). -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pos.auth.controller.ChangePasswordController"
      styleClass="dialog-root"
      prefWidth="440.0">

    <children>
        <VBox spacing="4.0">
            <children>
                <Label fx:id="dialogTitleLabel" styleClass="dialog-title" text="تغيير كلمة المرور"/>
                <Label fx:id="forcedNoticeLabel"
                       styleClass="text-secondary"
                       wrapText="true"
                       managed="false"
                       visible="false"
                       text="هذا الحساب ما زال يستخدم كلمة المرور التي حدّدها المسؤول. اختر كلمة مرور خاصة بك للمتابعة."/>
            </children>
        </VBox>

        <VBox spacing="12.0">
            <children>
                <VBox styleClass="form-field">
                    <children>
                        <Label styleClass="field-label" text="كلمة المرور الحالية"/>
                        <AppPasswordField fx:id="currentPasswordField"/>
                    </children>
                </VBox>

                <VBox styleClass="form-field">
                    <children>
                        <Label styleClass="field-label" text="كلمة المرور الجديدة"/>
                        <AppPasswordField fx:id="newPasswordField"/>
                    </children>
                </VBox>

                <VBox styleClass="form-field">
                    <children>
                        <Label styleClass="field-label" text="تأكيد كلمة المرور الجديدة"/>
                        <AppPasswordField fx:id="confirmPasswordField"/>
                    </children>
                </VBox>
            </children>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false" text=""/>

        <HBox styleClass="dialog-actions">
            <children>
                <AppButton fx:id="cancelButton" variant="SECONDARY" text="إلغاء" onAction="#onCancel"/>
                <AppButton variant="PRIMARY" text="حفظ" onAction="#onSave"/>
            </children>
        </HBox>
    </children>
</VBox>
